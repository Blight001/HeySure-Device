--- a/chrome/browser/download/download_prefs.cc
+++ b/chrome/browser/download/download_prefs.cc
@@ -11,6 +11,7 @@
 #include <vector>
 
 #include "base/check.h"
+#include "base/command_line.h"
 #include "base/feature_list.h"
 #include "base/files/file_util.h"
 #include "base/functional/bind.h"
@@ -72,6 +73,16 @@ using safe_browsing::FileTypePolicies;
 
 namespace {
 
+constexpr char kDownloadDefaultDirectorySwitch[] =
+    "download-default-directory";
+
+base::FilePath GetAiFreeLockedDownloadDirectory() {
+  const base::FilePath directory =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kDownloadDefaultDirectorySwitch);
+  return directory.IsAbsolute() ? directory : base::FilePath();
+}
+
 // Consider downloads 'dangerous' if they go to the home directory on Linux and
 // to the desktop on any platform.
 bool DownloadPathIsDangerous(const base::FilePath& download_path) {
@@ -139,6 +150,17 @@ DownloadPrefs::DownloadPrefs(Profile* profile) : profile_(profile) {
   PrefService* prefs = profile->GetPrefs();
   pref_change_registrar_.Init(prefs);
 
+  const base::FilePath ai_free_download_directory =
+      GetAiFreeLockedDownloadDirectory();
+  if (!ai_free_download_directory.empty()) {
+    prefs->SetFilePath(prefs::kDownloadDefaultDirectory,
+                       ai_free_download_directory);
+    prefs->SetFilePath(prefs::kSaveFileDefaultDirectory,
+                       ai_free_download_directory);
+    prefs->SetBoolean(prefs::kPromptForDownload, false);
+    prefs->SetBoolean(prefs::kDownloadDirUpgraded, true);
+  }
+
 #if BUILDFLAG(IS_CHROMEOS)
   // On Chrome OS, the default download directory is different for each profile.
   // If the profile-unaware default path (from GetDefaultDownloadDirectory())
@@ -367,19 +389,25 @@ bool DownloadPrefs::IsFromTrustedSource(const download::DownloadItem& item) {
 }
 
 base::FilePath DownloadPrefs::DownloadPath() const {
+  const base::FilePath locked = GetAiFreeLockedDownloadDirectory();
+  if (!locked.empty()) return locked;
   return SanitizeDownloadTargetPath(*download_path_);
 }
 
 void DownloadPrefs::SetDownloadPath(const base::FilePath& path) {
+  if (!GetAiFreeLockedDownloadDirectory().empty()) return;
   download_path_.SetValue(path);
   SetSaveFilePath(path);
 }
 
 base::FilePath DownloadPrefs::SaveFilePath() const {
+  const base::FilePath locked = GetAiFreeLockedDownloadDirectory();
+  if (!locked.empty()) return locked;
   return SanitizeDownloadTargetPath(*save_file_path_);
 }
 
 void DownloadPrefs::SetSaveFilePath(const base::FilePath& path) {
+  if (!GetAiFreeLockedDownloadDirectory().empty()) return;
   save_file_path_.SetValue(path);
 }
 
@@ -388,6 +416,7 @@ void DownloadPrefs::SetSaveFileType(int type) {
 }
 
 bool DownloadPrefs::PromptForDownload() const {
+  if (!GetAiFreeLockedDownloadDirectory().empty()) return false;
   // If the DownloadDirectory policy is set, then |prompt_for_download_| should
   // always be false.
   DCHECK(!download_path_.IsManaged() || !prompt_for_download_.GetValue());
@@ -408,6 +437,7 @@ bool DownloadPrefs::PromptForDownload() const {
 }
 
 bool DownloadPrefs::IsDownloadPathManaged() const {
+  if (!GetAiFreeLockedDownloadDirectory().empty()) return true;
   return download_path_.IsManaged();
 }
 
