diff --git a/chrome/browser/ui/views/frame/ai_free_takeover_guard.cc b/chrome/browser/ui/views/frame/ai_free_takeover_guard.cc
new file mode 100644
index 0000000..765bc00
--- /dev/null
+++ b/chrome/browser/ui/views/frame/ai_free_takeover_guard.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 AI-FREE Authors. All rights reserved.
+
+#include "chrome/browser/ui/views/frame/ai_free_takeover_guard.h"
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/timer/timer.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ai_free_file_selection.h"
+#include "chrome/browser/ui/browser_finder.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/contents_web_view.h"
+#include "components/javascript_dialogs/tab_modal_dialog_manager.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/browser/visibility.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/views/view.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+class TakeoverBorder : public views::View {
+ public:
+  TakeoverBorder() {
+    SetCanProcessEventsWithinSubtree(false);
+    SetProperty(views::kViewIgnoredByLayoutKey, true);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+  }
+  void OnPaint(gfx::Canvas* canvas) override {
+    gfx::RectF outer(GetLocalBounds());
+    outer.Inset(3.0f);
+    cc::PaintFlags glow;
+    glow.setAntiAlias(true);
+    glow.setStyle(cc::PaintFlags::kStroke_Style);
+    glow.setStrokeWidth(7.0f);
+    glow.setColor(SkColorSetARGB(95, 168, 85, 247));
+    canvas->DrawRoundRect(outer, 9.0f, glow);
+    cc::PaintFlags edge = glow;
+    edge.setStrokeWidth(2.0f);
+    edge.setColor(SkColorSetRGB(168, 85, 247));
+    canvas->DrawRoundRect(outer, 9.0f, edge);
+  }
+};
+
+class TakeoverSession
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<TakeoverSession> {
+ public:
+  explicit TakeoverSession(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<TakeoverSession>(*contents) {}
+  ~TakeoverSession() override {
+    guard_timer_.Stop();
+    DetachBorder();
+  }
+
+  bool SetActive(bool active) {
+    active_ = active;
+    AiFreeFileSelection::CreateForWebContents(web_contents());
+    AiFreeFileSelection::FromWebContents(web_contents())
+        ->SetTakeoverActive(active);
+    if (active) {
+      AttachBorder();
+      guard_timer_.Start(FROM_HERE, base::Milliseconds(100),
+                         base::BindRepeating(&TakeoverSession::Guard,
+                                             base::Unretained(this)));
+    } else {
+      guard_timer_.Stop();
+      DetachBorder();
+    }
+    return active_;
+  }
+  bool active() const { return active_; }
+  int blocked_dialogs() const { return blocked_dialogs_; }
+
+ private:
+  friend class content::WebContentsUserData<TakeoverSession>;
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (active_ && visibility != content::Visibility::VISIBLE) {
+      SetActive(false);
+    }
+  }
+  void Guard() {
+    if (!active_) return;
+    auto* dialogs =
+        javascript_dialogs::TabModalDialogManager::FromWebContents(web_contents());
+    if (dialogs &&
+        dialogs->HandleJavaScriptDialog(web_contents(), false, nullptr)) {
+      ++blocked_dialogs_;
+    }
+    AttachBorder();
+  }
+  void AttachBorder() {
+    Browser* browser = chrome::FindBrowserWithTab(web_contents());
+    BrowserView* browser_view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    if (!browser_view || !browser_view->contents_web_view()) return;
+    if (border_ && border_->parent() != browser_view) DetachBorder();
+    if (!border_) {
+      std::unique_ptr<views::View> border =
+          std::make_unique<TakeoverBorder>();
+      border_ = static_cast<TakeoverBorder*>(
+          browser_view->AddChildView(std::move(border)));
+    }
+    views::View* web_view = browser_view->contents_web_view();
+    border_->SetBoundsRect(views::View::ConvertRectToTarget(
+        web_view, browser_view, web_view->GetLocalBounds()));
+    border_->SchedulePaint();
+  }
+  void DetachBorder() {
+    if (!border_) return;
+    if (border_->parent()) border_->parent()->RemoveChildViewT(border_);
+    border_ = nullptr;
+  }
+
+  raw_ptr<TakeoverBorder> border_ = nullptr;
+  base::RepeatingTimer guard_timer_;
+  bool active_ = false;
+  int blocked_dialogs_ = 0;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TakeoverSession);
+
+base::DictValue Status(TakeoverSession* session, std::string action) {
+  base::DictValue result;
+  result.Set("success", true);
+  result.Set("action", std::move(action));
+  result.Set("takeoverActive", session && session->active());
+  result.Set("readOnly", !session || !session->active());
+  result.Set("modalGuardActive", session && session->active());
+  result.Set("blockedDialogCount", session ? session->blocked_dialogs() : 0);
+  result.Set("indicator", session && session->active() ? "purple-glow" : "none");
+  return result;
+}
+
+}  // namespace
+
+base::DictValue SetAiFreeTakeover(content::WebContents* web_contents,
+                                  bool active) {
+  TakeoverSession::CreateForWebContents(web_contents);
+  TakeoverSession* session = TakeoverSession::FromWebContents(web_contents);
+  session->SetActive(active);
+  return Status(session, active ? "acquire" : "release");
+}
+
+base::DictValue GetAiFreeTakeoverStatus(content::WebContents* web_contents) {
+  return Status(TakeoverSession::FromWebContents(web_contents), "status");
+}
+
+bool IsAiFreeTakeoverActive(content::WebContents* web_contents) {
+  TakeoverSession* session = TakeoverSession::FromWebContents(web_contents);
+  return session && session->active();
+}
