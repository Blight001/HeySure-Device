+void SetAiFreePointerConnected(Browser* browser, bool connected) {
+  if (!browser) {
+    return;
+  }
+  content::WebContents* active =
+      connected ? browser->tab_strip_model()->GetActiveWebContents() : nullptr;
+  for (auto& [contents, session] : Sessions()) {
+    if (session->BelongsTo(browser) && contents != active) {
+      session->SetConnected(false);
+    }
+  }
+  if (!active) {
+    return;
+  }
+  auto [it, inserted] = Sessions().try_emplace(active);
+  if (inserted) {
+    it->second = std::make_unique<PointerSession>(active);
+  }
+  it->second->SetConnected(true);
+}
