index 00000000..a892a5d8
--- /dev/null
+++ b/chrome/browser/ui/views/frame/ai_free_accessibility_observe.cc
@@ -0,0 +1,209 @@
+// Copyright 2026 AI-FREE Authors. All rights reserved.
+
+#include "chrome/browser/ui/views/frame/ai_free_accessibility_observe.h"
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/accessibility/ax_mode.h"
+#include "ui/accessibility/ax_node.h"
+#include "ui/accessibility/ax_node_data.h"
+#include "ui/accessibility/ax_tree.h"
+#include "ui/accessibility/ax_tree_update.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace {
+
+std::optional<double> Number(const base::DictValue& value,
+                             std::string_view key) {
+  if (std::optional<double> number = value.FindDouble(key)) {
+    return number;
+  }
+  if (std::optional<int> number = value.FindInt(key)) {
+    return static_cast<double>(*number);
+  }
+  return std::nullopt;
+}
+
+std::string ClipUtf8(std::string_view value, size_t limit) {
+  std::u16string text = base::UTF8ToUTF16(value);
+  if (text.size() > limit) {
+    text.resize(limit);
+  }
+  return base::UTF16ToUTF8(text);
+}
+
+bool IsDuplicate(const base::ListValue& items,
+                 const gfx::RectF& bounds,
+                 const gfx::PointF& point) {
+  for (const base::Value& value : items) {
+    const base::DictValue* item = value.GetIfDict();
+    if (!item) {
+      continue;
+    }
+    const std::optional<double> click_x = Number(*item, "clickX");
+    const std::optional<double> click_y = Number(*item, "clickY");
+    if (click_x && click_y && std::abs(*click_x - point.x()) <= 2.0 &&
+        std::abs(*click_y - point.y()) <= 2.0) {
+      return true;
+    }
+    const std::optional<double> x = Number(*item, "x");
+    const std::optional<double> y = Number(*item, "y");
+    const std::optional<double> width = Number(*item, "width");
+    const std::optional<double> height = Number(*item, "height");
+    if (!x || !y || !width || !height) {
+      continue;
+    }
+    gfx::RectF existing(*x, *y, *width, *height);
+    gfx::RectF overlap = existing;
+    overlap.Intersect(bounds);
+    const float smaller_area = std::min(existing.size().GetArea(),
+                                        bounds.size().GetArea());
+    if (smaller_area > 0 && overlap.size().GetArea() / smaller_area >= 0.8f) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void MergeAccessibilityItems(const base::DictValue& command,
+                             base::DictValue* response,
+                             ui::AXTreeUpdate& update) {
+  base::ListValue* items = response->FindList("items");
+  const base::DictValue* viewport = response->FindDict("viewport");
+  if (!items || !viewport || update.nodes.empty()) {
+    response->Set("accessibilitySupplementedCount", 0);
+    response->Set("closedShadowSupported", true);
+    return;
+  }
+  ui::AXTree tree(update);
+  if (!tree.root()) {
+    response->Set("accessibilitySupplementedCount", 0);
+    response->Set("closedShadowSupported", true);
+    return;
+  }
+
+  const int limit = std::clamp(command.FindInt("limit").value_or(200), 1, 1000);
+  const size_t text_limit = static_cast<size_t>(
+      std::clamp(command.FindInt("textLimit").value_or(120), 20, 500));
+  const std::string keyword = base::ToLowerASCII(
+      command.FindString("keyword") ? *command.FindString("keyword") : "");
+  const std::string tag_filter = base::ToLowerASCII(
+      command.FindString("tag") ? *command.FindString("tag") : "");
+  const std::string kind_filter = base::ToLowerASCII(
+      command.FindString("filter") ? *command.FindString("filter") : "");
+  const float viewport_width =
+      static_cast<float>(Number(*viewport, "width").value_or(0));
+  const float viewport_height =
+      static_cast<float>(Number(*viewport, "height").value_or(0));
+  const gfx::RectF viewport_bounds(0, 0, viewport_width, viewport_height);
+  int matched = response->FindInt("totalMatched").value_or(items->size());
+  int supplemented = 0;
+  bool truncated = response->FindBool("truncated").value_or(false);
+
+  std::vector<ui::AXNode*> pending = {tree.root()};
+  while (!pending.empty()) {
+    ui::AXNode* node = pending.back();
+    pending.pop_back();
+    for (ui::AXNode* child : node->children()) {
+      pending.push_back(child);
+    }
+    const ui::AXNodeData& data = node->data();
+    if (!data.IsClickable() || data.IsInvisibleOrIgnored() ||
+        data.GetRestriction() == ax::mojom::Restriction::kDisabled) {
+      continue;
+    }
+    bool offscreen = false;
+    gfx::RectF bounds = tree.GetTreeBounds(node, &offscreen, true);
+    bounds.Intersect(viewport_bounds);
+    if (offscreen || bounds.width() < 1 || bounds.height() < 1) {
+      continue;
+    }
+    const gfx::PointF point = bounds.CenterPoint();
+    if (IsDuplicate(*items, bounds, point)) {
+      continue;
+    }
+    std::string tag = base::ToLowerASCII(
+        data.GetStringAttribute(ax::mojom::StringAttribute::kHtmlTag));
+    if (tag.empty() && data.role == ax::mojom::Role::kButton) {
+      tag = "button";
+    }
+    std::string text =
+        data.GetStringAttribute(ax::mojom::StringAttribute::kName);
+    if (text.empty()) {
+      text = data.GetStringAttribute(ax::mojom::StringAttribute::kValue);
+    }
+    if (text.empty()) {
+      continue;
+    }
+    if ((!keyword.empty() &&
+         base::ToLowerASCII(text).find(keyword) == std::string::npos) ||
+        (!tag_filter.empty() && tag != tag_filter) ||
+        (!kind_filter.empty() && kind_filter != "interactive")) {
+      continue;
+    }
+    ++matched;
+    if (items->size() >= static_cast<size_t>(limit)) {
+      truncated = true;
+      continue;
+    }
+    const std::u16string full_text = base::UTF8ToUTF16(text);
+    base::DictValue item;
+    item.Set("id", "e" + std::to_string(matched));
+    item.Set("kind", "interactive");
+    item.Set("tag", tag.empty() ? "unknown" : tag);
+    item.Set("text", ClipUtf8(text, text_limit));
+    item.Set("textTruncated", full_text.size() > text_limit);
+    item.Set("name", "");
+    item.Set("placeholder", "");
+    item.Set("ariaLabel", ClipUtf8(text, text_limit));
+    item.Set("value", "");
+    item.Set("disabled", false);
+    item.Set("x", static_cast<int>(std::round(bounds.x())));
+    item.Set("y", static_cast<int>(std::round(bounds.y())));
+    item.Set("width", static_cast<int>(std::round(bounds.width())));
+    item.Set("height", static_cast<int>(std::round(bounds.height())));
+    item.Set("clickX", std::round(point.x() * 100.0f) / 100.0f);
+    item.Set("clickY", std::round(point.y() * 100.0f) / 100.0f);
+    item.Set("accessibilityFallback", true);
+    items->Append(std::move(item));
+    ++supplemented;
+  }
+  response->Set("count", static_cast<int>(items->size()));
+  response->Set("totalMatched", matched);
+  response->Set("truncated", truncated);
+  response->Set("accessibilitySupplementedCount", supplemented);
+  response->Set("closedShadowSupported", true);
+}
+
+void OnAccessibilitySnapshot(base::DictValue command,
+                             base::DictValue response,
+                             base::OnceCallback<void(base::DictValue)> callback,
+                             ui::AXTreeUpdate& update) {
+  MergeAccessibilityItems(command, &response, update);
+  std::move(callback).Run(std::move(response));
+}
+
+}  // namespace
+
+void SupplementAiFreeObserveWithAccessibility(
+    content::WebContents* web_contents,
+    base::DictValue command,
+    base::DictValue response,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  web_contents->RequestAXTreeSnapshot(
+      base::BindOnce(&OnAccessibilitySnapshot, std::move(command),
+                     std::move(response), std::move(callback)),
+      ui::kAXModeWebContentsOnly, 20000, base::Seconds(2),
+      content::WebContents::AXTreeSnapshotPolicy::kAll);
+}
