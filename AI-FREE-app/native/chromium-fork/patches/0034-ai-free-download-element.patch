+bool IsAllowedDownloadTarget(const base::FilePath& target) {
+  const base::FilePath root = base::CommandLine::ForCurrentProcess()
+                                  ->GetSwitchValuePath(
+                                      "download-default-directory");
+  return !root.empty() && target.IsAbsolute() && root.IsParent(target);
+}
+
+void OnElementDownloadStarted(AiFreeAutomationSuccess success,
+                              AiFreeAutomationFailure failure,
+                              base::DictValue response,
+                              download::DownloadItem* item,
+                              download::DownloadInterruptReason reason) {
+  if (!item || reason != download::DOWNLOAD_INTERRUPT_REASON_NONE) {
+    return Fail(std::move(failure), "ELEMENT_DOWNLOAD_START_FAILED",
+                "Chromium 无法启动图片元素下载");
+  }
+  response.Set("downloadStarted", true);
+  response.Set("downloadGuid", item->GetGuid());
+  std::move(success).Run(std::move(response));
+}
+
+void StartElementDownload(content::GlobalRenderFrameHostId frame_id,
+                          base::FilePath target_path,
+                          AiFreeAutomationSuccess success,
+                          AiFreeAutomationFailure failure,
+                          base::Value value) {
+  const base::DictValue* result = value.GetIfDict();
+  if (!result) {
+    return Fail(std::move(failure), "DOWNLOAD_ELEMENT_RESULT_INVALID",
+                "图片元素解析未返回对象");
+  }
+  if (!result->FindBool("success").value_or(false)) {
+    return std::move(success).Run(result->Clone());
+  }
+  const std::string* resource_url = result->FindString("resourceUrl");
+  const GURL url(resource_url ? *resource_url : "");
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return Fail(std::move(failure), "IMAGE_URL_UNAVAILABLE",
+                "图片元素没有可下载的 HTTP/HTTPS currentSrc");
+  }
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_id);
+  content::WebContents* contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (!contents) {
+    return Fail(std::move(failure), "WEB_CONTENTS_UNAVAILABLE",
+                "图片所在页面已不可用");
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  content::DownloadManager* manager = profile ? profile->GetDownloadManager() : nullptr;
+  if (!manager) {
+    return Fail(std::move(failure), "DOWNLOAD_MANAGER_UNAVAILABLE",
+                "Chromium 下载管理器不可用");
+  }
+  auto parameters =
+      content::DownloadRequestUtils::CreateDownloadForWebContentsMainFrame(
+          contents, url, kElementDownloadTrafficAnnotation);
+  parameters->set_file_path(target_path);
+  parameters->set_referrer(contents->GetLastCommittedURL());
+  parameters->set_prefer_cache(true);
+  parameters->set_callback(base::BindOnce(
+      &OnElementDownloadStarted, std::move(success), std::move(failure),
+      result->Clone()));
+  manager->DownloadUrl(std::move(parameters));
+}
+
+void DownloadElement(content::WebContents* web_contents,
+                     const base::DictValue& command,
+                     AiFreeAutomationSuccess success,
+                     AiFreeAutomationFailure failure) {
+  const std::string* raw_target = command.FindString("targetPath");
+  const base::FilePath target =
+      base::FilePath::FromUTF8Unsafe(raw_target ? *raw_target : "");
+  if (!IsAllowedDownloadTarget(target)) {
+    return Fail(std::move(failure), "DOWNLOAD_TARGET_FORBIDDEN",
+                "元素下载目标必须位于 AI-Workspace");
+  }
+  const content::GlobalRenderFrameHostId frame_id =
+      web_contents->GetPrimaryMainFrame()->GetGlobalId();
+  ExecuteIsolated(web_contents, DownloadElementScript(command),
+                  base::BindOnce(&StartElementDownload, frame_id, target,
+                                 std::move(success), std::move(failure)));
+}
