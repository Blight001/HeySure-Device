+void DispatchResolvedDrag(content::WebContents* contents,
+                          const base::DictValue& result,
+                          base::OnceCallback<void(bool)> callback) {
+  const base::DictValue* input = result.FindDict("nativeDrag");
+  if (!input) return std::move(callback).Run(false);
+  const std::optional<double> x = input->FindDouble("x");
+  const std::optional<double> y = input->FindDouble("y");
+  const std::optional<double> to_x = input->FindDouble("toX");
+  const std::optional<double> to_y = input->FindDouble("toY");
+  const std::optional<double> width = input->FindDouble("viewportWidth");
+  const std::optional<double> height = input->FindDouble("viewportHeight");
+  if (!x || !y || !to_x || !to_y || !width || !height || *width <= 0 ||
+      *height <= 0) {
+    return std::move(callback).Run(false);
+  }
+  const gfx::Rect bounds = contents->GetContainerBounds();
+  const auto scale = [&](double px, double py) {
+    return gfx::PointF(static_cast<float>(px * bounds.width() / *width),
+                       static_cast<float>(py * bounds.height() / *height));
+  };
+  DispatchAiFreeAnimatedDrag(contents, scale(*x, *y), scale(*to_x, *to_y),
+                             std::move(callback));
+}
