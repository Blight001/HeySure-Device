diff --git a/chrome/browser/ui/views/frame/ai_free_page_automation.cc b/chrome/browser/ui/views/frame/ai_free_page_automation.cc
--- a/chrome/browser/ui/views/frame/ai_free_page_automation.cc
+++ b/chrome/browser/ui/views/frame/ai_free_page_automation.cc
@@ -91,6 +91,8 @@ std::string ActionScript(const base::DictValue& command) {
     const a=)JS",
                        CommandJson(command),
                        R"JS(; const action=String(a.action||'');
     const roots=()=>{const out=[document];for(let i=0;i<out.length;i++){for(const e of out[i].querySelectorAll('*')){if(e.shadowRoot)out.push(e.shadowRoot);if(e.tagName==='IFRAME'){try{if(e.contentDocument)out.push(e.contentDocument);}catch(_){}}}}return out;};
     const find=()=>{for(const root of roots()){if(a.selector){try{const e=root.querySelector(a.selector);if(e)return e;}catch(_){}}const needle=String(a.text||'').trim();if(needle&&action!=='type'){for(const e of root.querySelectorAll('button,a,input,textarea,select,[role="button"],[contenteditable="true"]')){if(String(e.innerText||e.value||e.getAttribute('aria-label')||'').trim().includes(needle))return e;}}}return action==='press_key'?document.activeElement:null;};
+    const pointRequested=a.x!==undefined||a.y!==undefined;const mouseAction=action==='click'||action==='double_click'||action==='right_click'||action==='upload_file';
+    if(mouseAction&&pointRequested){const x=Number(a.x),y=Number(a.y);if(!Number.isFinite(x)||!Number.isFinite(y)||x<0||y<0||x>=innerWidth||y>=innerHeight)return {success:false,action,error:'目标坐标超出当前视口',errorCode:'TARGET_COORDINATE_INVALID'};return {success:true,action,ref:String(a.ref||''),targetMode:'viewport-coordinate',target:{x,y},nativeInput:{x,y,viewportWidth:innerWidth,viewportHeight:innerHeight}};}
     if(action==='wait')return find()?{success:true,action,found:true}:{success:false,action,error:'等待元素中',errorCode:'WAIT_PENDING'};
     const el=find();if(!el)return {success:false,action,error:'未找到目标元素',errorCode:'ELEMENT_NOT_FOUND'};el.scrollIntoView({block:'center',inline:'center'});el.focus();
