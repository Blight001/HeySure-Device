+void FinishObserve(content::GlobalRenderFrameHostId frame_id,
+                   bool show_highlights,
+                   int highlight_duration_ms,
+                   AiFreeAutomationSuccess success,
+                   base::DictValue response) {
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_id);
+  content::WebContents* contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (!contents || !response.FindBool("success").value_or(false)) {
+    return std::move(success).Run(std::move(response));
+  }
+  int highlighted_count = 0;
+  if (show_highlights) {
+    highlighted_count = ShowAiFreeObserveHighlights(
+        contents, response, base::Milliseconds(highlight_duration_ms));
+  } else {
+    ClearAiFreeObserveHighlights(contents);
+  }
+  response.Set("highlightMode", "chromium-native-overlay");
+  response.Set("highlightedCount", highlighted_count);
+  response.Set("highlightDurationMs", highlight_duration_ms);
+  std::move(success).Run(std::move(response));
+}
