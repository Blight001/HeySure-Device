From 5d90ea4a9d87655439cd134711f808fda6579764 Mon Sep 17 00:00:00 2001
From: AI-FREE Build <build@ai-free.local>
Date: Sun, 26 Jul 2026 20:00:00 +0800
Subject: [PATCH] Log Windows sandbox child launch failures

---
 content/browser/child_process_launcher_helper_win.cc | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/content/browser/child_process_launcher_helper_win.cc b/content/browser/child_process_launcher_helper_win.cc
--- a/content/browser/child_process_launcher_helper_win.cc
+++ b/content/browser/child_process_launcher_helper_win.cc
@@ -176,6 +176,14 @@ void ChildProcessLauncherHelper::FinishStartSandboxedProcessOnLauncherThread(
     DWORD last_error,
     int launch_result) {
   DCHECK(CurrentlyOnProcessLauncherTaskRunner());
+  if (launch_result != sandbox::SBOX_ALL_OK || !process.IsValid()) {
+    LOG(ERROR) << "AI-FREE sandbox child launch failed"
+               << " process-type="
+               << command_line()->GetSwitchValueASCII(switches::kProcessType)
+               << " sandbox-result=" << launch_result
+               << " win32-last-error=" << last_error
+               << " sandbox-tag=" << delegate_->GetSandboxTag();
+  }
   ChildProcessLauncherHelper::Process process_wrapper;
   process_wrapper.process = std::move(process);
   PostLaunchOnLauncherThread(std::move(process_wrapper), last_error,
-- 
